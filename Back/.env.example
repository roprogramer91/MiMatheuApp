# Railway genera esta variable automáticamente al agregar el servicio Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Puerto (Railway lo asigna automáticamente)
PORT=3000

# Google Calendar — ID del calendario de turnos
GOOGLE_CALENDAR_ID="tu_calendar_id@group.calendar.google.com"

# Google Service Account — pegar el JSON completo en una sola línea
GOOGLE_APPLICATION_CREDENTIALS='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# Cloudinary — para subir fotos de mascotas
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"
